let
    var a : Integer;
    var n : Integer
in
    begin
        if a < 0
        then put('1')
        else
        if n <= 0
        then put('2')
        else
        if n = 0
        then put('3')
        else
        if n > 0
        then put('4')
        else
        if n >= 0
        then put('5')
        else
        if n \= 0
        then put('6')
        else  n := 1
    end
